#!/bin/sh
# spacewm session launcher: what the login manager (or you, from a TTY) runs.
#
# It only sets the environment and replaces itself with spacewm (exec), so spacewm is
# the session leader and the session ends when spacewm exits. Exporting WAYLAND_DISPLAY
# to D-Bus / systemd --user happens inside spacewm, once its socket actually exists.

# Which desktop this is: xdg-desktop-portal picks its backends by this name
# (spacewm-portals.conf), and apps use it for per-desktop tweaks.
export XDG_CURRENT_DESKTOP=spacewm
export XDG_SESSION_DESKTOP=spacewm
export XDG_SESSION_TYPE=wayland

# Ask toolkits to use Wayland instead of falling back to X11.
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
# Older Electron apps: native Wayland, sharp on any scale. Newer Electron ignores this
# variable and uses X11 (Xwayland, works fine); for native Wayland there, put
# --ozone-platform=wayland in the app's flags file, e.g. ~/.config/code-flags.conf.
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Keyboard layouts are set in ~/.config/spacewm/config.toml ([input] keyboard_layout);
# when that is empty, xkb falls back to XKB_DEFAULT_LAYOUT and then "us".

# SPACEWM_BIN: run a development build instead of the installed one, e.g.
#   SPACEWM_BIN=~/spacewm/target/release/spacewm spacewm-session
exec "${SPACEWM_BIN:-spacewm}" --backend drm "$@"
